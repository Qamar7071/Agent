{
  "name": "raahi-ai-travel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "images": "python scripts/build_images.py",
    "test:api": "cd backend && python -m pytest -q",
    "test:e2e": "python e2e/run_e2e.py",
    "audit:a11y": "python e2e/audit.py",
    "test:unit": "node --test src/lib/companion/companion.test.js src/lib/decided.test.js src/lib/bestMonths.test.js src/lib/tripMap.test.js src/lib/pipeline.test.js src/lib/discover.test.js src/lib/tripFacts.test.js"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.14",
    "vite": "6.4.5"
  }
}
