# Frontend and build settings. Copy to .env (gitignored) only if you need to change them.
# The backend has its own settings in backend/.env.example.
#
# Never put API keys in VITE_ variables: everything starting with VITE_ is built into the
# JavaScript that every visitor downloads. AI and other keys belong in the backend only.

# `npm run dev` (port 5173) forwards /api/* to this backend
VITE_BACKEND_URL=http://localhost:5000

# Only if the API runs on a different domain from the website (CORS must allow the site;
# see ALLOWED_ORIGINS in backend/.env.example). Empty means the same domain (/api).
VITE_API_BASE_URL=

# Used by `npm run build` for canonical links, the sitemap and robots.txt.
# Read from the shell or the hosting dashboard (not from this file). On Vercel it defaults
# to the project's production domain.
# SITE_URL=https://your-domain.example
