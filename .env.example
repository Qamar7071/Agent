# Where your existing AI backend runs (dev proxy target for /api/*)
VITE_BACKEND_URL=http://localhost:5000

# Optional: in production, call a backend on another origin instead of same-origin /api
# VITE_API_BASE_URL=https://your-backend.example.com

# Endpoint paths on that backend (change to match your routes)
VITE_CHAT_ENDPOINT=/api/chat
VITE_PLAN_ENDPOINT=/api/plan

# Live weather (Open-Meteo) and Google Maps links/embeds need NO key — they work already.
#
# Optional: if you later add live distances (Google Distance Matrix) or live hotels
# (Google Places), do it in your BACKEND and return the data from /api/plan.
# Never put API keys (OpenAI, Gemini, Google, etc.) in VITE_ vars — they ship to the browser.
# Keep all keys in the backend's own .env.
