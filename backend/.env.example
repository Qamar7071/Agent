# Raahi backend settings.
# Local development: copy this file to backend/.env (gitignored) and fill in what you need.
# Vercel or Render: add the same names under the project's Environment Variables instead.
# Empty means "not set". Never commit real keys.

# ── AI model (optional) ───────────────────────────────────────────────────────────
# Without a key, the planner, live data, saving and enquiries all still work, and the chat
# answers in "guided" mode (rule-based; each reply says so).
# Any OpenAI-compatible chat API with tool calling works, for example:
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1                                LLM_MODEL=gpt-4o-mini
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=openai/gpt-oss-120b
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Other models on the same provider to try if the first fails (comma-separated)
LLM_FALLBACK_MODELS=

# Backup provider, used when the main one fails or runs out of quota
LLM2_API_KEY=
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM2_MODEL=gemini-3.8-flash
LLM2_FALLBACK_MODELS=

LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=900

# Agent guard rails, per chat message: model turns, tool calls, total seconds,
# and the most characters of one tool result shown to the model
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_DEADLINE_S=45
AGENT_TOOL_RESULT_CHARS=6000

# ── Database ─────────────────────────────────────────────────────────────────────
# Saved trips and booking enquiries.
# Locally, leave it empty to use backend/raahi.db (SQLite).
# On Vercel or Render, saving stays off until this is a Postgres URL (Neon, Supabase,
# Vercel Postgres...), shaped like: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Protects the admin page (/admin) and /api/admin/*. Booking enquiries stay switched off
# until this is set, so no one's details are collected without someone to review them.
# Make a long random value with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── Live data (no keys needed) ───────────────────────────────────────────────────
HTTP_TIMEOUT_S=8
# Open-Meteo forecasts
WEATHER_ENABLED=true
# Pakistan Meteorological Department (PMD) public alert feed
PMD_ALERTS_ENABLED=true
# OSRM drive times (public demo server unless you host your own)
ROUTING_ENABLED=true
OSRM_URL=https://router.project-osrm.org
# OpenStreetMap places to stay and eat (Overpass API), and the servers to ask, in order
PLACES_ENABLED=true
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Contact link sent to those services in the User-Agent header
RAAHI_CONTACT=https://github.com/Qamar7071/Agent

# Optional: news search for possible road closures (Tavily, tavily.com).
# Results are always shown as unverified reports, never as road status.
TAVILY_API_KEY=
# Optional: URL of a separately hosted KKH risk model, shown as an experimental estimate
KKH_RISK_API_URL=

# ── Web ──────────────────────────────────────────────────────────────────────────
SITE_URL=https://north-kappa-ivory.vercel.app
# Browser origins allowed to call the API (comma-separated).
# Empty means SITE_URL plus the local dev servers.
ALLOWED_ORIGINS=
MAX_BODY_BYTES=65536
# Trust the X-Forwarded-For header for rate limiting. Empty means: yes on Vercel and
# Render (their proxies set it), no anywhere else.
TRUST_PROXY=

# Requests per minute per visitor
PLAN_RATE_PER_MIN=40
LIVE_RATE_PER_MIN=60
CHAT_RATE_PER_MIN=12
WRITE_RATE_PER_MIN=6
AGENT_RATE_PER_MIN=20

# Log detail: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Local development server only (python app.py). Render sets PORT itself.
# HOST=0.0.0.0 makes it reachable from other devices on your network.
HOST=127.0.0.1
PORT=5000
